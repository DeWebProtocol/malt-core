{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malt.dev/schemas/authentication-batch.schema.json",
  "title": "Exact authentication candidate batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "transaction_id",
    "base",
    "root",
    "candidates"
  ],
  "properties": {
    "profile": {
      "const": "malt.authentication-batch/1"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "authentication.schema.json#/$defs/candidate"
      }
    }
  }
}
