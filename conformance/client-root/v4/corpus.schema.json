{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deweb.world/schemas/malt/conformance/client-root/v4/corpus.schema.json",
  "title": "MALT Client-root Conformance Corpus v4 (V0 roots)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vectors"],
  "properties": {
    "schema_version": {
      "const": "malt.client-root.conformance/v4"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "vector.schema.json"
      }
    }
  }
}
